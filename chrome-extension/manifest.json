{
  "manifest_version": 3,
  "name": "COSS UI Theme Tweak",
  "version": "0.0.1",
  "description": "A Chrome extension for UI theme tweaking",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "side_panel": {
    "default_path": "dist/sidePanel/index.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Side Panel"
  }
}
