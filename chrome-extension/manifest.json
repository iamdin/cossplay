{
  "manifest_version": 3,
  "name": "COSS UI Theme Tweak",
  "version": "0.0.1",
  "description": "A Chrome extension for UI theme tweaking",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://coss.com/*"
  ],
  "side_panel": {
    "default_path": "dist/side-panel/index.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coss.com/ui",
        "https://coss.com/ui/*"
      ],
      "js": [
        "dist/contentScript.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Side Panel"
  }
}
