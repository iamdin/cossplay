{
  "manifest_version": 3,
  "name": "COSS UI Theme Tweak",
  "version": "0.0.1",
  "description": "Live-edit coss ui theme variables on any website, from your side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.iife.ts"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Side Panel"
  }
}
